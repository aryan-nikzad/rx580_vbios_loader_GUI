# ---------------------------------------------------------------------------------------------
#  RX 580 vBIOS Loader - configuration file            (copy to \EFI\vbios_loader\vbios_loader.cfg)
#
#  * One setting per line:   name=value        Lines starting with # or ; are comments.
#  * Every setting is OPTIONAL. The loader has the best defaults built in, so it works with no file.
#  * The loader NEVER writes this file. Only you / the installer edit it.
#  * Priority:  built-in default  <  this file  <  settings page (stored in NVRAM)
#    (press S on the status page; DEL on a setting returns it to this file / the default)
# ---------------------------------------------------------------------------------------------

# ---- interface -------------------------------------------------------------------------------
# gui  = graphical status page (needs a display that offers GOP), text = classic console,
# auto = gui when possible, otherwise text
ui_mode=auto
# 0 = automatic (1x on <=1080p, 2x on 1440p/4K), or 1..3
ui_scale=0

# ---- start / finish --------------------------------------------------------------------------
# auto = start by itself after menu_timeout, menu = wait on the status page until you press a key
boot_mode=auto
# seconds before AUTO starts (1..30; default 1). Any key cancels the countdown and keeps the menu open.
menu_timeout=1
# seconds the finished status page stays on screen before the OS boot continues (0 = no pause)
finish_secs=8
# seconds before handing control back to firmware for OS boot (1..30; default 2).
# Minimum 1 second so there is always an opportunity to interrupt; any key cancels the countdown.
boot_delay=2
# when a card could not be initialised: wait for a key instead of continuing
hold_on_fail=1

# ---- what to do per card ---------------------------------------------------------------------
# leave cards alone that are already initialised and trained (they are shown green)
skip_initialized=1
# after a ROM failed:  gpu    = AMD config reset of that one card (proven, default)
#                      pcie   = PCIe secondary-bus reset of that card's upstream bridge (experimental)
#                      reboot = cold-reboot the whole PC, the next boot continues with the next ROM
#                      none   = no reset, just try the next ROM
reset_mode=gpu
# try ROM files whose name contains the card's brand (xfx, gigabyte, asus, msi, sapphire, ...) first
smart_order=1
# if a ROM pinned to a card fails, continue with the other ROMs
pin_fallback=1
# retry cards whose ROM list was used up on every boot (off = press R on the status page)
retry_failed=0

# ---- engine (leave alone unless you know why) -----------------------------------------------
# atom = built-in AtomBIOS interpreter (recommended), gop = firmware GOP driver (can hang the PC)
engine=atom
# a register poll that has not finished after this many ms is skipped
loop_ms=300
gop_timeout=12
vfct_only=0
post_dump=0
trace=1

# how the ROMs are handed to Linux (ACPI VFCT table, one image per loaded card, built once after the last card):
#   auto = ACPI table protocol, falls back to patching the XSDT; acpi = protocol only;
#   xsdt = patch the XSDT directly (use this if the PC freezes inside the ACPI call; see loader_trace.txt); off = none
vfct_mode=auto

# ---- folders ---------------------------------------------------------------------------------
# ROM folder on the loader's own EFI partition. Default: \EFI\vbios_loader\vbioses
#rom_dir=\EFI\vbios_loader\vbioses

# ---- per-card settings (find the PCI address on the status page, hex bus:dev.fn) -------------
# pin a ROM file to one card (that card tries it first):
#card.03:00.0.rom=00a_user_xfx_micron_mtd0_1366-2000.rom
#card.06:00.0.rom=00g_user_gigabyte_22fc_1340-2000.rom
# leave one card completely alone:
#card.0a:00.0.skip=1
# always run initialization for one card, even when it already appears green:
#card.03:00.0.force=1
# skip and force are mutually exclusive when changed from the loader UI.
# a label shown for the card (max 23 chars):
#card.03:00.0.name=Rig slot 1

# ---- preview ---------------------------------------------------------------------------------
# show 5 fake cards to preview the interface (touches no hardware)
demo=0
